# {{name}}: {{core}} in the ChipFoundry OpenFrame (generated by `sipath new --template openframe`).
#   python3 -m sipath run design.yaml [workdir]
# Pads: 0 clock, 1-{{in_hi}} inputs, {{out_lo}}-{{out_hi}} outputs (east edge); the rows are a strip
# along that edge, next to every pad used. Edit rtl/{{core}}.v; keep its ports.
name: {{name}}
top: openframe_project_wrapper
mode: macro
pdk: sky130A
harness: openframe
harness_options:
  core_region: [2900.0, 300.0, 3120.0, 4650.0]   # 220 um east strip (one strap pitch): pads 0-14, vccd1/vssd1
rtl: [rtl/{{core}}.v, rtl/{{name}}_wrapper.v]
rtl_defines: {OPENFRAME_IO_PADS: 44}
sdc: rtl/{{name}}.sdc
clock_ports: ["gpio_in[0]"]
config:
  tool_timeout: 21600        # LVS of the strip (fill and decap cells) is long under emulation
flow:
- step: synth
  variants: [{port_buffers: false, equiv_reset: "resetb_l:0"}]   # pad controls stay wires to the frame's loopback inputs
- step: floorplan
- step: physical
- step: place
  variants: [{timing_driven: false, density: 0.4}]
- step: cts
- step: route_analog
- step: route_digital
- step: route_repair
  variants: [{fillers: [sky130_fd_sc_hd__fill_2, sky130_fd_sc_hd__fill_1], drv_sizing: true}]
                                      # fill only: the strip is mostly empty rows, decaps there (~70k)
                                      # would only add LVS devices; drivers of nets over the slew limit
                                      # on extracted parasitics sized up
- step: extract
- step: signoff
- step: integrate                     # the wrapper in the OpenFrame chip, checked against the frame
